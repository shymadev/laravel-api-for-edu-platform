#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
export PRE_COMMIT_HOME="${PRE_COMMIT_HOME:-$(git rev-parse --git-path pre-commit-cache)}"

if command -v pre-commit >/dev/null 2>&1; then
    exec pre-commit run --hook-stage pre-commit --config "$ROOT/.pre-commit-config.yaml" "$@"
fi

LOCAL_PRE_COMMIT="$ROOT/.git/pre-commit-venv/bin/pre-commit"
if [ -x "$LOCAL_PRE_COMMIT" ]; then
    exec "$LOCAL_PRE_COMMIT" run --hook-stage pre-commit --config "$ROOT/.pre-commit-config.yaml" "$@"
fi

echo "pre-commit is not installed."
echo "Install it with: python3 -m pip install --user pre-commit"
exit 1
