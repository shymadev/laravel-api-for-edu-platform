{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "laravel/cashier": "^16.1",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.32",
        "openai-php/client": "^0.17.1",
        "symfony/http-client": "^8.0",
        "symfony/mailgun-mailer": "^8.0",
        "wotz/laravel-swagger-ui": "^1.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "*",
        "larastan/larastan": "*",
        "laravel/boost": "^1.8",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
          "@lint",
          "@phpcs",
          "@analyse",
          "@php artisan config:clear --ansi",
          "@php artisan test "
        ],
        "unit-test": [
          "@php artisan test --testsuite=Unit"
        ],
        "feature-test": [
          "@php artisan test --testsuite=Feature"
        ],
        "lint": [
          "php-cs-fixer fix --dry-run --diff --verbose"
        ],
        "fix": [
          "php-cs-fixer fix --verbose"
        ],
        "analyse": [
          "phpstan analyse --memory-limit=1G --ansi"
        ],
        "phpcs": [
          "phpcs"
        ],
        "phpcbf": [
          "phpcbf"
        ],
        "hooks:install": [
          "git config core.hooksPath hooks"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
