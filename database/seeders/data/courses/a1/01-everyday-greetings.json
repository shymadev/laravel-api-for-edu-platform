            {
              "title": "Common Greetings",
              "weight": 1,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000001000,\"blocks\":[{\"id\":\"aB1cD2eF3g\",\"type\":\"paragraph\",\"data\":{\"text\":\"In English, we use different words to greet people depending on the time of day and the situation.\"}},{\"id\":\"hI4jK5lM6n\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Hello</b> — a standard, friendly greeting\",\"<b>Hi</b> — informal, used with friends\",\"<b>Good morning</b> — used before noon\",\"<b>Good afternoon</b> — used from noon to 6 pm\",\"<b>Good evening</b> — used after 6 pm\"]}},{\"id\":\"oP7qR8sT9u\",\"type\":\"paragraph\",\"data\":{\"text\":\"To say goodbye, we use: <b>Goodbye</b>, <b>Bye</b>, <b>See you later</b>, or <b>Good night</b> (when someone is going to sleep).\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Good morning! How are you?",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
                  "order": 3,
                  "type": "phrases",
                  "phrases": [
                    {
                      "text": "Hello",
                      "translation": "Привет / Здравствуйте"
                    },
                    {
