        {
          "title": "1.2 Asking How Someone Is",
          "lessons": [
            {
              "title": "Asking and Answering 'How Are You?'",
              "weight": 3,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000003000,\"blocks\":[{\"id\":\"lM8nO9pQ0r\",\"type\":\"paragraph\",\"data\":{\"text\":\"A very common exchange in English is asking how someone is feeling. Here are useful phrases:\"}},{\"id\":\"sT1uV2wX3y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Asking:</b>\"}},{\"id\":\"zA4bC5dE6f\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"How are you?\",\"How are you doing?\",\"How's it going?\"]}},{\"id\":\"gH7iJ8kL9m\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Positive answers:</b>\"}},{\"id\":\"nO0pQ1rS2t\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I'm fine, thank you.\",\"I'm great!\",\"Very well, thanks.\",\"Not bad.\"]}},{\"id\":\"uV3wX4yZ5a\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Negative answers:</b>\"}},{\"id\":\"bC6dE7fG8h\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I'm tired.\",\"Not so good.\",\"I'm a little sick.\"]}},{\"id\":\"iJ9kL0mN1o\",\"type\":\"paragraph\",\"data\":{\"text\":\"Always remember to ask back: <b>And you?</b> or <b>What about you?</b>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "How are you? I'm fine, thank you!",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
