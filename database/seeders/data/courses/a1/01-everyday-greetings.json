            {
              "title": "Formal vs Informal Greetings",
              "weight": 2,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000002000,\"blocks\":[{\"id\":\"vW0xY1zA2b\",\"type\":\"paragraph\",\"data\":{\"text\":\"English greetings can be <b>formal</b> or <b>informal</b>.\"}},{\"id\":\"cD3eF4gH5i\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Formal greetings</b> are used in professional situations, with strangers, or with older people:\"}},{\"id\":\"jK6lM7nO8p\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"Good morning, Mr. Smith.\",\"Good afternoon, Ms. Johnson.\",\"How do you do?\"]}},{\"id\":\"qR9sT0uV1w\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Informal greetings</b> are used with friends and family:\"}},{\"id\":\"xY2zA3bC4d\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"Hey! What's up?\",\"Hi! How are you?\",\"Long time no see!\"]}},{\"id\":\"eF5gH6iJ7k\",\"type\":\"paragraph\",\"data\":{\"text\":\"A common reply to <em>How are you?</em> is: <b>I'm fine, thank you.</b> or <b>I'm good, thanks!</b>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Good morning, Mr. Smith. How do you do?",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
