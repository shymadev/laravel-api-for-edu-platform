              "weight": 9,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000009000,\"blocks\":[{\"id\":\"rS2tU3vW4x\",\"type\":\"paragraph\",\"data\":{\"text\":\"Now let's put everything together! Here is a complete introduction dialogue:\"}},{\"id\":\"yZ5aB6cD7e\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Anna:</b> Hi! Good morning!\"}},{\"id\":\"fG8hI9jK0l\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tom:</b> Good morning! How are you?\"}},{\"id\":\"mN1oP2qR3s\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Anna:</b> I'm fine, thank you! What's your name?\"}},{\"id\":\"tU4vW5xY6z\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tom:</b> My name is Tom. Nice to meet you!\"}},{\"id\":\"aB7cD8eF9g\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Anna:</b> Nice to meet you too! I'm Anna. Where are you from?\"}},{\"id\":\"hI0jK1lM2n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tom:</b> I'm from England. And you?\"}},{\"id\":\"oP3qR4sT5u\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Anna:</b> I'm from Belarus. How old are you?\"}},{\"id\":\"vW6xY7zA8b\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tom:</b> I'm 24. And you?\"}},{\"id\":\"cD9eF0gH1i\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Anna:</b> I'm 22. Bye, Tom!\"}},{\"id\":\"jK2lM3nO4p\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tom:</b> Goodbye, Anna! See you later!\"}}],\"version\":\"2.31.4\"}"
