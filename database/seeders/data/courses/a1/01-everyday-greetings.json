            {
              "title": "Where Are You From?",
              "weight": 5,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000005000,\"blocks\":[{\"id\":\"fG0hI1jK2l\",\"type\":\"paragraph\",\"data\":{\"text\":\"To talk about your country or city, use these phrases:\"}},{\"id\":\"mN3oP4qR5s\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>I am from Russia.</b> (I'm from Russia.)\",\"<b>I live in Moscow.</b>\",\"<b>I come from Belarus.</b>\"]}},{\"id\":\"tU6vW7xY8z\",\"type\":\"paragraph\",\"data\":{\"text\":\"To ask where someone is from:\"}},{\"id\":\"aB9cD0eF1g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Where are you from?</b>\",\"<b>Where do you come from?</b>\",\"<b>Where do you live?</b>\"]}},{\"id\":\"hI2jK3lM4n\",\"type\":\"paragraph\",\"data\":{\"text\":\"Examples:\"}},{\"id\":\"oP5qR6sT7u\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I'm from the USA.\",\"I'm from France. I live in Paris.\",\"She is from Japan.\"]}}],\"version\":\"2.31.4\"}"
                },
