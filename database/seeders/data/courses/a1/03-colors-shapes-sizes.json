    {
      "title": "Module 4: Describing Objects",
      "subtopics": [],
      "lessons": [
        {
          "title": "Color + Shape + Size Together",
          "weight": 7,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700002007000,\"blocks\":[{\"id\":\"jJ8kK9lL0m\",\"type\":\"paragraph\",\"data\":{\"text\":\"In English, when we use multiple adjectives, they follow a specific order:\"}},{\"id\":\"mM1nN2oO3p\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Size → Color → Shape → Noun</b>\"}},{\"id\":\"pP4qQ5rR6s\",\"type\":\"paragraph\",\"data\":{\"text\":\"Examples:\"}},{\"id\":\"sS7tT8uU9v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"a <b>big red</b> ball\",\"a <b>small blue</b> circle\",\"a <b>long yellow</b> banana\",\"a <b>small round</b> coin\"]}},{\"id\":\"vV0wW1xX2y\",\"type\":\"paragraph\",\"data\":{\"text\":\"Questions to describe things:\"}},{\"id\":\"yY3zZ4aA5b\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>What color is it?</b> — It is blue.\",\"<b>What shape is it?</b> — It is round.\",\"<b>How big is it?</b> — It is small.\"]}}],\"version\":\"2.31.4\"}"
            },
