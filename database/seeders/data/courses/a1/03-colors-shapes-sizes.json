    {
      "title": "Module 3: Size Adjectives",
      "subtopics": [
        {
          "title": "3.1 Big and Small",
          "lessons": [
            {
              "title": "Describing Size",
              "weight": 5,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700002005000,\"blocks\":[{\"id\":\"oO7pP8qQ9r\",\"type\":\"paragraph\",\"data\":{\"text\":\"Size adjectives help us describe how large or small something is.\"}},{\"id\":\"rR0sS1tT2u\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Basic size adjectives:</b>\"}},{\"id\":\"uU3vV4wW5x\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>big / large</b> — большой\",\"<b>small / little</b> — маленький\",\"<b>tall</b> — высокий (for people or things that are high)\",\"<b>short</b> — короткий / низкий\",\"<b>long</b> — длинный\",\"<b>wide</b> — широкий\",\"<b>narrow</b> — узкий\",\"<b>thick</b> — толстый\",\"<b>thin</b> — тонкий/худой\"]}},{\"id\":\"xX6yY7zZ8a\",\"type\":\"paragraph\",\"data\":{\"text\":\"Adjectives go <b>before the noun</b>: a <em>big</em> house, a <em>small</em> cat, a <em>tall</em> building.\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "An elephant is big. A mouse is small. A giraffe is very tall.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
                  "order": 3,
                  "type": "phrases",
