      "lessons": [
        {
          "title": "Common Shapes",
          "weight": 3,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700002003000,\"blocks\":[{\"id\":\"qQ3rR4sS5t\",\"type\":\"paragraph\",\"data\":{\"text\":\"Here are the most common shapes in English:\"}},{\"id\":\"tT6uU7vV8w\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>circle</b> — круг (e.g. a coin, the sun)\",\"<b>square</b> — квадрат (e.g. a tile, a window)\",\"<b>triangle</b> — треугольник (e.g. a road sign, a pizza slice)\",\"<b>rectangle</b> — прямоугольник (e.g. a door, a book)\",\"<b>star</b> — звезда\",\"<b>heart</b> — сердце\",\"<b>oval</b> — овал (e.g. an egg)\"]}},{\"id\":\"wW9xX0yY1z\",\"type\":\"paragraph\",\"data\":{\"text\":\"To describe shape: <em>The table is <b>rectangular</b>.</em> or <em>It is a <b>round</b> table.</em>\"}},{\"id\":\"zZ2aA3bB4c\",\"type\":\"paragraph\",\"data\":{\"text\":\"Shape adjectives: circle → <b>round/circular</b>, square → <b>square</b>, triangle → <b>triangular</b>.\"}}],\"version\":\"2.31.4\"}"
            },
            {
              "order": 2,
              "type": "audio",
              "content": {
