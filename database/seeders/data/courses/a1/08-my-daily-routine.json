          "title": "4.1 Evening and Night Activities",
          "lessons": [
            {
              "title": "Evening Vocabulary",
              "weight": 7,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700007007000,\"blocks\":[{\"id\":\"vV3wW4xX5y\",\"type\":\"paragraph\",\"data\":{\"text\":\"The <b>evening</b> is from about 6:00 pm to bedtime. Common evening activities:\"}},{\"id\":\"yY6zZ7aA8b\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>cook dinner</b> — готовить ужин\",\"<b>eat dinner</b> — ужинать\",\"<b>wash the dishes</b> — мыть посуду\",\"<b>watch TV</b> — смотреть телевизор\",\"<b>read a book</b> — читать книгу\",\"<b>take a shower / bath</b> — принять душ / ванну\",\"<b>relax</b> — отдыхать\",\"<b>go to bed</b> — ложиться спать\",\"<b>fall asleep</b> — засыпать\"]}},{\"id\":\"bB9cC0dD1e\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Time phrases:</b> in the evening, at night, at 9 o'clock, before bed\"}}],\"version\":\"2.31.4\"}"
