                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700007008000,\"blocks\":[{\"id\":\"eE2fF3gG4h\",\"type\":\"paragraph\",\"data\":{\"text\":\"To talk about your schedule, learn the <b>days of the week</b>:\"}},{\"id\":\"hH5iI6jJ7k\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Monday</b> — понедельник\",\"<b>Tuesday</b> — вторник\",\"<b>Wednesday</b> — среда\",\"<b>Thursday</b> — четверг\",\"<b>Friday</b> — пятница\",\"<b>Saturday</b> — суббота\",\"<b>Sunday</b> — воскресенье\"]}},{\"id\":\"kK8lL9mM0n\",\"type\":\"paragraph\",\"data\":{\"text\":\"Use <b>on</b> with days: <em>I go swimming <b>on Monday</b>.</em>\"}},{\"id\":\"nN1oO2pP3q\",\"type\":\"paragraph\",\"data\":{\"text\":\"Useful time expressions:\"}},{\"id\":\"qQ4rR5sS6t\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>in the morning</b> — утром\",\"<b>at noon</b> — в полдень\",\"<b>in the afternoon</b> — днём\",\"<b>in the evening</b> — вечером\",\"<b>at night</b> — ночью\",\"<b>every day</b> — каждый день\",\"<b>on weekdays</b> — в рабочие дни\",\"<b>on weekends</b> — в выходные\"]}}],\"version\":\"2.31.4\"}"
