        {
          "title": "What I Do in the Afternoon",
          "weight": 5,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700007005000,\"blocks\":[{\"id\":\"zA2bB3cC4d\",\"type\":\"paragraph\",\"data\":{\"text\":\"The <b>afternoon</b> is from 12:00 (noon) to about 6:00 pm. Common afternoon activities:\"}},{\"id\":\"dD5eE6fF7g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>have lunch</b> — обедать\",\"<b>study</b> — учиться / учить\",\"<b>work</b> — работать\",\"<b>meet friends</b> — встречаться с друзьями\",\"<b>go shopping</b> — ходить по магазинам\",\"<b>do sport</b> — заниматься спортом\",\"<b>walk the dog</b> — гулять с собакой\",\"<b>take a nap</b> — вздремнуть\"]}},{\"id\":\"gG8hH9iI0j\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Time phrases:</b> in the afternoon, at noon, at 2 o'clock, after school, after work\"}}],\"version\":\"2.31.4\"}"
            },
