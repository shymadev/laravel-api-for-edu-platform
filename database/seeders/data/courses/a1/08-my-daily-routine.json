            {
              "title": "Morning Vocabulary",
              "weight": 3,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700007003000,\"blocks\":[{\"id\":\"pP6qQ7rR8s\",\"type\":\"paragraph\",\"data\":{\"text\":\"The <b>morning</b> is the time from when you wake up until about 12:00 (noon). Common morning activities:\"}},{\"id\":\"sS9tT0uU1v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>take a shower</b> — принять душ\",\"<b>have a bath</b> — принять ванну\",\"<b>comb / brush hair</b> — расчесать волосы\",\"<b>shave</b> — бриться\",\"<b>put on makeup</b> — нанести макияж\",\"<b>make breakfast</b> — приготовить завтрак\",\"<b>drink coffee / tea</b> — выпить кофе / чай\",\"<b>read the news</b> — читать новости\",\"<b>leave home</b> — выйти из дома\"]}},{\"id\":\"vV2wW3xX4y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Time phrases:</b> in the morning, at 7 o'clock, early, before school\"}}],\"version\":\"2.31.4\"}"
