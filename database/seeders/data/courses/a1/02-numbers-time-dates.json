    {
      "title": "Module 3: Telling the Time",
      "subtopics": [
        {
          "title": "3.1 Hours and Minutes",
          "lessons": [
            {
              "title": "What Time Is It?",
              "weight": 5,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700001005000,\"blocks\":[{\"id\":\"cC9dD0eE1f\",\"type\":\"paragraph\",\"data\":{\"text\":\"To ask for the time: <b>What time is it?</b> or <b>What's the time?</b>\"}},{\"id\":\"fF2gG3hH4i\",\"type\":\"paragraph\",\"data\":{\"text\":\"To answer, use these patterns:\"}},{\"id\":\"iI5jJ6kK7l\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"It's <b>three o'clock</b>. (3:00)\",\"It's <b>half past four</b>. (4:30)\",\"It's <b>quarter past six</b>. (6:15)\",\"It's <b>quarter to nine</b>. (8:45)\",\"It's <b>ten past two</b>. (2:10)\",\"It's <b>twenty to five</b>. (4:40)\"]}},{\"id\":\"lL8mM9nN0o\",\"type\":\"paragraph\",\"data\":{\"text\":\"We also use <b>am</b> (morning) and <b>pm</b> (afternoon/evening):\"}},{\"id\":\"oO1pP2qQ3r\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"It's 9 am = nine o'clock in the morning.\",\"It's 3 pm = three o'clock in the afternoon.\"]}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "What time is it? It's half past three.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
                  "order": 3,
                  "type": "phrases",
                  "phrases": [
                    {
                      "text": "What time is it?",
                      "translation": "Который час?"
                    },
                    {
                      "text": "It's three o'clock.",
                      "translation": "Три часа."
                    },
                    {
                      "text": "half past four",
                      "translation": "половина пятого"
                    },
                    {
                      "text": "quarter past six",
                      "translation": "четверть седьмого"
                    }
                  ]
                },
