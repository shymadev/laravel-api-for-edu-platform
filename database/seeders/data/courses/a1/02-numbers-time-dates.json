        {
          "title": "5.2 Saying Dates",
          "lessons": [
            {
              "title": "How to Say and Write Dates",
              "weight": 9,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700001009000,\"blocks\":[{\"id\":\"hH6iI7jJ8k\",\"type\":\"paragraph\",\"data\":{\"text\":\"In English, dates use <b>ordinal numbers</b> and month names.\"}},{\"id\":\"kK9lL0mM1n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>British English:</b> day + month + year → <em>the 5th of March, 2024</em>\"}},{\"id\":\"nN2oO3pP4q\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>American English:</b> month + day + year → <em>March 5th, 2024</em>\"}},{\"id\":\"qQ5rR6sS7t\",\"type\":\"paragraph\",\"data\":{\"text\":\"When we say the date out loud:\"}},{\"id\":\"tT8uU9vV0w\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"1 May → <b>the first of May</b>\",\"15 June → <b>the fifteenth of June</b>\",\"31 December → <b>the thirty-first of December</b>\"]}},{\"id\":\"wW1xX2yY3z\",\"type\":\"paragraph\",\"data\":{\"text\":\"To ask the date: <b>What is the date today?</b> or <b>What's today's date?</b>\"}},{\"id\":\"zZ4aA5bB6c\",\"type\":\"paragraph\",\"data\":{\"text\":\"Common reply: <em>Today is the tenth of April.</em>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Today is the tenth of April. My birthday is on the first of January.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
