    {
      "title": "Module 6: Simple Schedules",
      "subtopics": [],
      "lessons": [
        {
          "title": "My Weekly Schedule",
          "weight": 10,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700001010000,\"blocks\":[{\"id\":\"cC7dD8eE9f\",\"type\":\"paragraph\",\"data\":{\"text\":\"Now you can combine numbers, time, and days to talk about a schedule!\"}},{\"id\":\"fF0gG1hH2i\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Useful prepositions:</b>\"}},{\"id\":\"iI3jJ4kK5l\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>at</b> — for specific times: at 8 o'clock, at noon, at midnight\",\"<b>on</b> — for days: on Monday, on Friday, on weekends\",\"<b>in</b> — for months and parts of the day: in January, in the morning\"]}},{\"id\":\"lL6mM7nN8o\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Example schedule:</b>\"}},{\"id\":\"oO9pP0qQ1r\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"On Monday, I have English class <em>at 9 am</em>.\",\"On Wednesday, I go to the gym <em>at 6 pm</em>.\",\"On Saturday, I sleep late and relax.\"]}}],\"version\":\"2.31.4\"}"
            },
            {
              "order": 2,
              "type": "audio",
              "content": {
                "text": "On Monday I have class at nine o'clock in the morning.",
                "type": "tts",
