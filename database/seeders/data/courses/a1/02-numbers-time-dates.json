            {
              "title": "AM and PM — Morning, Afternoon, Evening",
              "weight": 6,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700001006000,\"blocks\":[{\"id\":\"rR4sS5tT6u\",\"type\":\"paragraph\",\"data\":{\"text\":\"In English, the day is divided into parts. We use them when talking about daily schedules:\"}},{\"id\":\"uU7vV8wW9x\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>in the morning</b> — from about 6 am to 12 pm\",\"<b>in the afternoon</b> — from 12 pm to about 6 pm\",\"<b>in the evening</b> — from about 6 pm to midnight\",\"<b>at night</b> — late evening and night time\",\"<b>at noon</b> — exactly 12:00 pm\",\"<b>at midnight</b> — exactly 12:00 am\"]}},{\"id\":\"xX0yY1zZ2a\",\"type\":\"paragraph\",\"data\":{\"text\":\"Examples:\"}},{\"id\":\"aA3bB4cC5d\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I wake up at 7 o'clock <b>in the morning</b>.\",\"Lunch is at <b>noon</b>.\",\"I watch TV <b>in the evening</b>.\"]}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "I wake up in the morning and go to bed at night.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
