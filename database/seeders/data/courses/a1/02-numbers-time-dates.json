    {
      "title": "Module 4: Days of the Week",
      "subtopics": [],
      "lessons": [
        {
          "title": "The Seven Days",
          "weight": 7,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700001007000,\"blocks\":[{\"id\":\"dD6eE7fF8g\",\"type\":\"paragraph\",\"data\":{\"text\":\"There are <b>7 days</b> in a week. In English, they are:\"}},{\"id\":\"gG9hH0iI1j\",\"type\":\"list\",\"data\":{\"style\":\"ordered\",\"items\":[\"<b>Monday</b>\",\"<b>Tuesday</b>\",\"<b>Wednesday</b>\",\"<b>Thursday</b>\",\"<b>Friday</b>\",\"<b>Saturday</b>\",\"<b>Sunday</b>\"]}},{\"id\":\"jJ2kK3lL4m\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Weekdays</b> are Monday to Friday. <b>Weekend</b> is Saturday and Sunday.\"}},{\"id\":\"mM5nN6oO7p\",\"type\":\"paragraph\",\"data\":{\"text\":\"To talk about days:\"}},{\"id\":\"pP8qQ9rR0s\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"Today is <b>Monday</b>.\",\"I work <b>on Monday</b>.\",\"I rest <b>on Saturday</b>.\"]}},{\"id\":\"sS1tT2uU3v\",\"type\":\"paragraph\",\"data\":{\"text\":\"Ask: <b>What day is it today?</b>\"}}],\"version\":\"2.31.4\"}"
            },
            {
              "order": 2,
              "type": "audio",
              "content": {
                "text": "Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday.",
                "type": "tts",
                "audio_url": ""
              }
            },
            {
              "order": 3,
              "type": "matching",
              "pairs": [
                {
                  "id": "1700001007001",
                  "left": "Monday",
                  "right": "Понедельник"
                },
                {
                  "id": "1700001007002",
                  "left": "Wednesday",
                  "right": "Среда"
                },
