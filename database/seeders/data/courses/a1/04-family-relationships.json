    {
      "title": "Module 3: Possessive Pronouns",
      "subtopics": [
        {
          "title": "3.1 My, Your, His, Her",
          "lessons": [
            {
              "title": "Using Possessive Pronouns",
              "weight": 5,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700003005000,\"blocks\":[{\"id\":\"zA2bB3cC4d\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Possessive pronouns</b> show who something belongs to. They replace 'the ... of ...'\"}},{\"id\":\"dD5eE6fF7g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I → <b>my</b> — my mother\",\"you → <b>your</b> — your father\",\"he → <b>his</b> — his sister\",\"she → <b>her</b> — her brother\",\"we → <b>our</b> — our family\",\"they → <b>their</b> — their children\"]}},{\"id\":\"gG8hH9iI0j\",\"type\":\"paragraph\",\"data\":{\"text\":\"The possessive goes before the noun: <em><b>My</b> mother is kind.</em>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "My mother is kind. His sister is tall. Their children are young.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
                  "order": 3,
                  "type": "matching",
                  "pairs": [
                    {
                      "id": "1700003005001",
                      "left": "I",
                      "right": "my"
                    },
                    {
                      "id": "1700003005002",
                      "left": "you",
                      "right": "your"
                    },
                    {
                      "id": "1700003005003",
                      "left": "he",
                      "right": "his"
                    },
                    {
                      "id": "1700003005004",
                      "left": "she",
                      "right": "her"
                    },
                    {
                      "id": "1700003005005",
                      "left": "we",
                      "right": "our"
                    },
                    {
                      "id": "1700003005006",
                      "left": "they",
                      "right": "their"
                    }
                  ],
                  "shuffleRight": true
                },
                {
                  "order": 4,
                  "type": "fill-gaps",
                  "text": "I have a sister. [My] sister is 18. He has a brother. [His] brother is a student. She has a mother. [Her] mother is kind.",
                  "gaps": [
                    {
                      "placeholder": "My",
                      "answers": [
                        "My"
                      ]
                    },
                    {
                      "placeholder": "His",
                      "answers": [
                        "His"
                      ]
                    },
                    {
                      "placeholder": "Her",
                      "answers": [
                        "Her"
                      ]
                    }
                  ]
                },
                {
                  "order": 5,
                  "type": "vocabulary-game",
                  "gameType": "find-mistake",
                  "words": [],
                  "oddItems": [],
                  "guessItems": [],
                  "listenItems": [],
                  "mistakeItems": [
                    {
                      "text": "She loves his cat. (about Anna)",
                      "correctText": "She loves her cat. (about Anna)"
                    },
                    {
                      "text": "He plays with her dog. (about Tom)",
                      "correctText": "He plays with his dog. (about Tom)"
                    }
                  ]
                },
                {
                  "order": 6,
                  "type": "test",
                  "questions": [
                    {
                      "text": "Which possessive pronoun goes with 'she'?",
                      "options": [
                        "his",
                        "my",
