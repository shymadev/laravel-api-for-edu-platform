            {
              "title": "Mother, Father, Brother, Sister",
              "weight": 1,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700003001000,\"blocks\":[{\"id\":\"aA1bB2cC3d\",\"type\":\"paragraph\",\"data\":{\"text\":\"Your <b>immediate family</b> (closest family) includes:\"}},{\"id\":\"dD4eE5fF6g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>mother / mom</b> — мама\",\"<b>father / dad</b> — папа\",\"<b>parents</b> — родители (mother + father)\",\"<b>son</b> — сын\",\"<b>daughter</b> — дочь\",\"<b>brother</b> — брат\",\"<b>sister</b> — сестра\",\"<b>child / children</b> — ребёнок / дети\"]}},{\"id\":\"gG7hH8iI9j\",\"type\":\"paragraph\",\"data\":{\"text\":\"Examples:\"}},{\"id\":\"jJ0kK1lL2m\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"My <b>mother</b> is kind.\",\"I have one <b>brother</b> and two <b>sisters</b>.\",\"Her <b>father</b> is a doctor.\"]}}],\"version\":\"2.31.4\"}"
                },
                {
