          "title": "Grandparents, Aunts, Uncles and Cousins",
          "weight": 4,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700003004000,\"blocks\":[{\"id\":\"qQ3rR4sS5t\",\"type\":\"paragraph\",\"data\":{\"text\":\"Your <b>extended family</b> includes relatives beyond your parents and siblings:\"}},{\"id\":\"tT6uU7vV8w\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>grandfather / grandpa</b> — дедушка\",\"<b>grandmother / grandma</b> — бабушка\",\"<b>grandparents</b> — бабушка и дедушка\",\"<b>uncle</b> — дядя (your parent's brother)\",\"<b>aunt</b> — тётя (your parent's sister)\",\"<b>cousin</b> — двоюродный брат/сестра\",\"<b>nephew</b> — племянник\",\"<b>niece</b> — племянница\"]}},{\"id\":\"wW9xX0yY1z\",\"type\":\"paragraph\",\"data\":{\"text\":\"Example: <em>My <b>grandmother</b> is 70 years old. She lives with my <b>uncle</b>.</em>\"}}],\"version\":\"2.31.4\"}"
            },
