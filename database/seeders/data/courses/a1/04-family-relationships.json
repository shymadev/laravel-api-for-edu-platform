                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700003003000,\"blocks\":[{\"id\":\"eE1fF2gG3h\",\"type\":\"paragraph\",\"data\":{\"text\":\"Words for adult relationships in English:\"}},{\"id\":\"hH4iI5jJ6k\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>husband</b> — муж\",\"<b>wife</b> — жена\",\"<b>partner</b> — партнёр (neutral term)\",\"<b>boyfriend</b> — молодой человек / друг\",\"<b>girlfriend</b> — девушка / подруга\",\"<b>married</b> — женат / замужем\",\"<b>single</b> — один / незамужняя\"]}},{\"id\":\"kK7lL8mM9n\",\"type\":\"paragraph\",\"data\":{\"text\":\"Useful phrases:\"}},{\"id\":\"nN0oO1pP2q\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I am <b>married</b>. My <b>husband</b> is a teacher.\",\"She is <b>single</b>.\",\"They have two <b>children</b>.\"]}}],\"version\":\"2.31.4\"}"
                },
