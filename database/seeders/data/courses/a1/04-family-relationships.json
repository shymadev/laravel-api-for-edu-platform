    {
      "title": "Module 4: Describing Your Family",
      "subtopics": [],
      "lessons": [
        {
          "title": "Talking About Family Members",
          "weight": 7,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700003007000,\"blocks\":[{\"id\":\"vV3wW4xX5y\",\"type\":\"paragraph\",\"data\":{\"text\":\"When describing family members, we can combine vocabulary from this course with adjectives:\"}},{\"id\":\"yY6zZ7aA8b\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Age:</b> My grandmother is <b>70 years old</b>.\"}},{\"id\":\"bB9cC0dD1e\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Job:</b> My father is <b>a teacher</b>.\"}},{\"id\":\"eE2fF3gG4h\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Appearance:</b> My sister has <b>long brown hair</b>.\"}},{\"id\":\"hH5iI6jJ7k\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Character:</b>\"}},{\"id\":\"kK8lL9mM0n\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>kind</b> — добрый\",\"<b>funny</b> — смешной\",\"<b>clever</b> — умный\",\"<b>quiet</b> — тихий/спокойный\",\"<b>tall / short</b> — высокий / низкий\"]}},{\"id\":\"nN1oO2pP3q\",\"type\":\"paragraph\",\"data\":{\"text\":\"Example: <em>My mother is <b>kind</b> and <b>clever</b>. She is a doctor. She is 45 years old.</em>\"}}],\"version\":\"2.31.4\"}"
            },
            {
              "order": 2,
              "type": "audio",
              "content": {
                "text": "My mother is kind and clever. She is a doctor.",
                "type": "tts",
                "audio_url": ""
              }
            },
            {
              "order": 3,
              "type": "vocabulary-game",
              "gameType": "odd-one-out",
              "words": [],
              "oddItems": [
                {
                  "words": [
                    "kind",
                    "funny",
                    "clever",
                    "sister"
                  ],
                  "correctWord": "sister"
                },
                {
                  "words": [
                    "father",
                    "mother",
                    "brother",
                    "tall"
                  ],
                  "correctWord": "tall"
                }
              ],
              "guessItems": [],
              "listenItems": [],
              "mistakeItems": []
            },
            {
