                      ],
                      "correctOptions": [
                        2
                      ]
                    },
                    {
                      "text": "Complete: ___ family is big. (talking about 'we')",
                      "options": [
                        "My",
                        "Their",
                        "Our",
                        "His"
                      ],
                      "correctOptions": [
                        2
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "Practice: His or Her?",
              "weight": 6,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700003006000,\"blocks\":[{\"id\":\"jJ1kK2lL3m\",\"type\":\"paragraph\",\"data\":{\"text\":\"A common mistake for beginners is confusing <b>his</b> and <b>her</b>.\"}},{\"id\":\"mM4nN5oO6p\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"Use <b>his</b> for a <em>male</em> (he): <em>Tom loves <b>his</b> dog.</em>\",\"Use <b>her</b> for a <em>female</em> (she): <em>Anna loves <b>her</b> cat.</em>\"]}},{\"id\":\"pP7qQ8rR9s\",\"type\":\"paragraph\",\"data\":{\"text\":\"The possessive does NOT change based on what is owned — it changes based on who OWNS it!\"}},{\"id\":\"sS0tT1uU2v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"Tom has a sister. <b>His</b> sister is tall. ✓\",\"Anna has a brother. <b>Her</b> brother is young. ✓\"]}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Tom loves his dog. Anna loves her cat.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
                  "order": 3,
                  "type": "sentence-task",
                  "tasks": [
                    {
                      "sentence": "Tom loves ___ mother.",
                      "answers": [
                        "his",
                        "her",
                        "my"
                      ]
                    },
                    {
                      "sentence": "Anna likes ___ dog.",
                      "answers": [
                        "her",
                        "his",
                        "my"
                      ]
                    },
                    {
                      "sentence": "My brother and I love ___ grandma.",
                      "answers": [
                        "our",
                        "their",
                        "his"
                      ]
                    }
                  ]
                },
                {
