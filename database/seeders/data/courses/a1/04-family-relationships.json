                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700003009000,\"blocks\":[{\"id\":\"pP8qQ9rR0s\",\"type\":\"paragraph\",\"data\":{\"text\":\"Let's review all the family vocabulary from this course!\"}},{\"id\":\"sS1tT2uU3v\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Immediate family:</b> mother, father, brother, sister, son, daughter\"}},{\"id\":\"vV4wW5xX6y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Spouses and partners:</b> husband, wife, boyfriend, girlfriend\"}},{\"id\":\"yY7zZ8aA9b\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Extended family:</b> grandfather, grandmother, uncle, aunt, cousin, nephew, niece\"}},{\"id\":\"bB0cC1dD2e\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Possessives:</b> my, your, his, her, our, their\"}},{\"id\":\"eE3fF4gG5h\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Key phrases:</b>\"}},{\"id\":\"hH6iI7jJ8k\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I have a big / small family.\",\"My mother/father is a ...\",\"Do you have any brothers or sisters?\"]}}],\"version\":\"2.31.4\"}"
