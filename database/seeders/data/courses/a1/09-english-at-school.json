                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009001000,\"blocks\":[{\"id\":\"aA1bB2cC3d\",\"type\":\"paragraph\",\"data\":{\"text\":\"Look around your classroom! Here are the most common <b>classroom objects</b>:\"}},{\"id\":\"dD4eE5fF6g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>desk</b> — парта\",\"<b>chair</b> — стул\",\"<b>board / blackboard</b> — доска\",\"<b>book / textbook</b> — книга / учебник\",\"<b>notebook / exercise book</b> — тетрадь\",\"<b>pen</b> — ручка\",\"<b>pencil</b> — карандаш\",\"<b>ruler</b> — линейка\",\"<b>eraser / rubber</b> — ластик\",\"<b>bag / school bag</b> — сумка / рюкзак\",\"<b>map</b> — карта\",\"<b>computer</b> — компьютер\"]}}],\"version\":\"2.31.4\"}"
                },
