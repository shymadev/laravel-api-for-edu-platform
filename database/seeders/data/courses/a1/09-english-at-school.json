            {
              "title": "Classroom Commands",
              "weight": 2,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009002000,\"blocks\":[{\"id\":\"gG7hH8iI9j\",\"type\":\"paragraph\",\"data\":{\"text\":\"Teachers use <b>commands</b> (instructions) in the classroom. Listen and do!\"}},{\"id\":\"jJ0kK1lL2m\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Open your book.</b> — Откройте книгу.\",\"<b>Close your book.</b> — Закройте книгу.\",\"<b>Listen.</b> — Слушайте.\",\"<b>Repeat.</b> — Повторите.\",\"<b>Write.</b> — Пишите.\",\"<b>Read.</b> — Читайте.\",\"<b>Stand up.</b> — Встаньте.\",\"<b>Sit down.</b> — Сядьте.\",\"<b>Be quiet.</b> — Тихо.\",\"<b>Come to the board.</b> — Подойдите к доске.\"]}},{\"id\":\"mM3nN4oO5p\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em>Tip: these verbs (commands) are in the <b>imperative</b> form — no subject needed!</em>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Open your book. Listen. Repeat. Write. Sit down.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
