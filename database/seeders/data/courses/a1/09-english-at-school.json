          "weight": 5,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700009005000,\"blocks\":[{\"id\":\"nN0oO1pP2q\",\"type\":\"paragraph\",\"data\":{\"text\":\"Who do you meet at school? Learn the <b>people vocabulary</b>:\"}},{\"id\":\"qQ3rR4sS5t\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>student / pupil</b> — ученик\",\"<b>teacher</b> — учитель\",\"<b>headteacher / principal</b> — директор школы\",\"<b>classmate</b> — одноклассник\",\"<b>friend</b> — друг\",\"<b>librarian</b> — библиотекарь\",\"<b>school secretary</b> — секретарь школы\"]}},{\"id\":\"tT6uU7vV8w\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Useful phrases:</b>\"}},{\"id\":\"wW9xX0yY1z\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"This is my <b>teacher</b>. Her name is Ms Smith.\",\"He is my best <b>friend</b> and <b>classmate</b>.\",\"The <b>headteacher</b> is in the office.\"]}}],\"version\":\"2.31.4\"}"
            },
