            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700009008000,\"blocks\":[{\"id\":\"yY6zZ7aA8b\",\"type\":\"paragraph\",\"data\":{\"text\":\"Let's describe a typical <b>school day</b>. Read this example:\"}},{\"id\":\"bB9cC0dD1e\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em>I go to school at <b>8 o'clock</b> in the morning. My first lesson is English. Then I have Maths and History. We have a <b>break</b> at 10:30 — I talk with my <b>classmates</b>. After break, I have Science and Geography. School finishes at <b>2 o'clock</b>. I go home and do my <b>homework</b>.</em>\"}},{\"id\":\"eE2fF3gG4h\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Key verbs:</b>\"}},{\"id\":\"hH5iI6jJ7k\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>start / begin</b> — начинаться\",\"<b>finish / end</b> — заканчиваться\",\"<b>have a lesson</b> — иметь урок\",\"<b>do homework</b> — делать домашнее задание\",\"<b>take a test</b> — писать контрольную\"]}}],\"version\":\"2.31.4\"}"
