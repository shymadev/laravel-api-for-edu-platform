        {
          "title": "Describing Your School",
          "weight": 6,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700009006000,\"blocks\":[{\"id\":\"zA2bB3cC4d\",\"type\":\"paragraph\",\"data\":{\"text\":\"Learn words to describe <b>places</b> in your school:\"}},{\"id\":\"dD5eE6fF7g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>classroom</b> — класс\",\"<b>corridor / hallway</b> — коридор\",\"<b>library</b> — библиотека\",\"<b>gym / sports hall</b> — спортзал\",\"<b>canteen / cafeteria</b> — столовая\",\"<b>playground</b> — площадка для игр\",\"<b>office</b> — кабинет / офис\",\"<b>toilet / bathroom</b> — туалет\"]}},{\"id\":\"gG8hH9iI0j\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Asking for directions in school:</b>\"}},{\"id\":\"jJ1kK2lL3m\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"Where is the library? — Где библиотека?\",\"It is on the first floor. — На первом этаже.\",\"Turn left / right. — Поверните налево / направо.\"]}}],\"version\":\"2.31.4\"}"
            },
            {
              "order": 2,
              "type": "audio",
              "content": {
                "text": "The library is on the first floor. The canteen is next to the gym.",
                "type": "tts",
                "audio_url": ""
              }
            },
