        {
          "title": "2.1 Names of Subjects",
          "lessons": [
            {
              "title": "My Favourite Subject",
              "weight": 3,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009003000,\"blocks\":[{\"id\":\"pP6qQ7rR8s\",\"type\":\"paragraph\",\"data\":{\"text\":\"Here are the main <b>school subjects</b> in English:\"}},{\"id\":\"sS9tT0uU1v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>English</b> — английский язык\",\"<b>Maths / Mathematics</b> — математика\",\"<b>Science</b> — наука / естествознание\",\"<b>History</b> — история\",\"<b>Geography</b> — география\",\"<b>Art</b> — изобразительное искусство\",\"<b>Music</b> — музыка\",\"<b>PE (Physical Education)</b> — физкультура\",\"<b>Computer Studies / IT</b> — информатика\",\"<b>Biology</b> — биология\",\"<b>Chemistry</b> — химия\",\"<b>Physics</b> — физика\"]}},{\"id\":\"vV2wW3xX4y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Useful phrases:</b>\"}},{\"id\":\"yY5zZ6aA7b\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"My <b>favourite subject</b> is Maths. — Мой любимый предмет — математика.\",\"I like / I don't like History. — Мне нравится / не нравится история.\",\"I have English on Monday. — У меня английский в понедельник.\"]}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "My favourite subject is English. I also like Maths and Art.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
