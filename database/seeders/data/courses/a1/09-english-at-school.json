    {
      "title": "Module 4: School Timetable",
      "subtopics": [
        {
          "title": "4.1 Classes and Timetables",
          "lessons": [
            {
              "title": "My School Timetable",
              "weight": 7,
              "content": [
                {
                  "order": 1,
                  "type": "text",
