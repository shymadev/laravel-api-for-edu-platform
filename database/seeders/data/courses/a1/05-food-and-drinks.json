            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700004008000,\"blocks\":[{\"id\":\"wW0xX1yY2z\",\"type\":\"paragraph\",\"data\":{\"text\":\"In English, the three main meals of the day are:\"}},{\"id\":\"zA3bB4cC5d\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>breakfast</b> — завтрак (in the morning, usually 7–9 am)\",\"<b>lunch</b> — обед (in the afternoon, usually 12–2 pm)\",\"<b>dinner</b> — ужин (in the evening, usually 6–8 pm)\"]}},{\"id\":\"dD6eE7fF8g\",\"type\":\"paragraph\",\"data\":{\"text\":\"A small meal between meals is a <b>snack</b>.\"}},{\"id\":\"gG9hH0iI1j\",\"type\":\"paragraph\",\"data\":{\"text\":\"Typical breakfast foods: toast, eggs, cereal, coffee, juice.\"}},{\"id\":\"jJ2kK3lL4m\",\"type\":\"paragraph\",\"data\":{\"text\":\"Typical lunch foods: sandwich, soup, salad.\"}},{\"id\":\"mM5nN6oO7p\",\"type\":\"paragraph\",\"data\":{\"text\":\"Typical dinner foods: meat, fish, pasta, vegetables.\"}},{\"id\":\"pP8qQ9rR0s\",\"type\":\"paragraph\",\"data\":{\"text\":\"Useful phrases:\"}},{\"id\":\"sS1tT2uU3v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>What do you have for breakfast?</b>\",\"<b>I usually eat toast for breakfast.</b>\"]}}],\"version\":\"2.31.4\"}"
