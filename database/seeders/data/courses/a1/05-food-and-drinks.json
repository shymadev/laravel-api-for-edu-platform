                    },
                    {
                      "id": "1700004006002",
                      "english": "She doesn't like fish.",
                      "russian": "Она не любит рыбу.",
                      "direction": "eng-ru"
                    },
                    {
                      "id": "1700004006003",
                      "english": "Do you like coffee?",
                      "russian": "Ты любишь кофе?",
                      "direction": "eng-ru"
                    },
                    {
                      "id": "1700004006004",
                      "english": "He hates onions.",
                      "russian": "Он ненавидит лук.",
                      "direction": "eng-ru"
                    }
                  ]
                },
                {
