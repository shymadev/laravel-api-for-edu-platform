          "lessons": [
            {
              "title": "Staple Foods",
              "weight": 3,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700004003000,\"blocks\":[{\"id\":\"sS9tT0uU1v\",\"type\":\"paragraph\",\"data\":{\"text\":\"These are everyday staple foods you'll find in most homes:\"}},{\"id\":\"vV2wW3xX4y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Bread and grains:</b>\"}},{\"id\":\"yY5zZ6aA7b\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>bread</b> — хлеб\",\"<b>rice</b> — рис\",\"<b>pasta</b> — макароны\",\"<b>cereal</b> — хлопья\"]}},{\"id\":\"bB8cC9dD0e\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Meat and fish:</b>\"}},{\"id\":\"eE1fF2gG3h\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>chicken</b> — курица\",\"<b>beef</b> — говядина\",\"<b>pork</b> — свинина\",\"<b>fish</b> — рыба\"]}},{\"id\":\"hH4iI5jJ6k\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Dairy:</b>\"}},{\"id\":\"kK7lL8mM9n\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>milk</b> — молоко\",\"<b>cheese</b> — сыр\",\"<b>butter</b> — масло\",\"<b>egg</b> — яйцо\"]}}],\"version\":\"2.31.4\"}"
