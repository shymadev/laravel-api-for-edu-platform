    {
      "title": "Module 4: At the Café",
      "subtopics": [],
      "lessons": [
        {
          "title": "Ordering Food and Drinks",
          "weight": 7,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700004007000,\"blocks\":[{\"id\":\"eE2fF3gG4h\",\"type\":\"paragraph\",\"data\":{\"text\":\"When you go to a café or restaurant, you need to order food. Here are key phrases:\"}},{\"id\":\"hH5iI6jJ7k\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Waiter to customer:</b>\"}},{\"id\":\"kK8lL9mM0n\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"Can I help you?\",\"What would you like?\",\"Are you ready to order?\"]}},{\"id\":\"nN1oO2pP3q\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Customer to waiter:</b>\"}},{\"id\":\"qQ4rR5sS6t\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>I would like</b> a coffee, please.\",\"<b>Can I have</b> a sandwich?\",\"<b>I'll have</b> the pasta.\",\"Could I have the bill/check, please?\"]}},{\"id\":\"tT7uU8vV9w\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Polite words:</b> <em>please</em> and <em>thank you</em> are very important!\"}}],\"version\":\"2.31.4\"}"
