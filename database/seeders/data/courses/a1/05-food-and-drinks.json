    {
      "title": "Module 2: Drinks",
      "subtopics": [],
      "lessons": [
        {
          "title": "Common Drinks",
          "weight": 4,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700004004000,\"blocks\":[{\"id\":\"nN0oO1pP2q\",\"type\":\"paragraph\",\"data\":{\"text\":\"Here are the most common <b>drinks</b> in English:\"}},{\"id\":\"qQ3rR4sS5t\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>water</b> — вода\",\"<b>juice</b> — сок (apple juice, orange juice)\",\"<b>tea</b> — чай\",\"<b>coffee</b> — кофе\",\"<b>milk</b> — молоко\",\"<b>lemonade</b> — лимонад\",\"<b>soda / fizzy drink</b> — газировка\",\"<b>smoothie</b> — смузи\"]}},{\"id\":\"tT6uU7vV8w\",\"type\":\"paragraph\",\"data\":{\"text\":\"To order a drink:\"}},{\"id\":\"wW9xX0yY1z\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"Can I have a <b>tea</b>, please?\",\"I would like a glass of <b>water</b>.\",\"One <b>coffee</b>, please.\"]}}],\"version\":\"2.31.4\"}"
            },
            {
              "order": 2,
              "type": "audio",
              "content": {
                "text": "Can I have a glass of water, please?",
                "type": "tts",
                "audio_url": ""
              }
