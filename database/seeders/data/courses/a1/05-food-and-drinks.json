                  "type": "text",
                  "content": "{\"time\":1700004001000,\"blocks\":[{\"id\":\"aA1bB2cC3d\",\"type\":\"paragraph\",\"data\":{\"text\":\"Here are the most common <b>fruits</b> in English:\"}},{\"id\":\"dD4eE5fF6g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>apple</b> — яблоко\",\"<b>banana</b> — банан\",\"<b>orange</b> — апельсин\",\"<b>strawberry</b> — клубника\",\"<b>grape</b> — виноград\",\"<b>lemon</b> — лимон\",\"<b>mango</b> — манго\",\"<b>pear</b> — груша\",\"<b>watermelon</b> — арбуз\",\"<b>cherry</b> — вишня\"]}},{\"id\":\"gG7hH8iI9j\",\"type\":\"paragraph\",\"data\":{\"text\":\"Fruits are often <b>countable</b>: an apple, two bananas, three oranges.\"}}],\"version\":\"2.31.4\"}"
