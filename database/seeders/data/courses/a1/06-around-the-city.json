            {
              "title": "A Directions Dialogue",
              "weight": 7,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700005007000,\"blocks\":[{\"id\":\"qQ4rR5sS6t\",\"type\":\"paragraph\",\"data\":{\"text\":\"Here is a complete dialogue about asking for and giving directions:\"}},{\"id\":\"tT7uU8vV9w\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tourist:</b> Excuse me! Is there a bank near here?\"}},{\"id\":\"wW0xX1yY2z\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Local:</b> Yes! Go straight ahead along this street. At the traffic lights, turn left. The bank is on the right, next to the supermarket.\"}},{\"id\":\"zA3bB4cC5d\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tourist:</b> Is it far?\"}},{\"id\":\"dD6eE7fF8g\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Local:</b> No, it's about 5 minutes' walk.\"}},{\"id\":\"gG9hH0iI1j\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tourist:</b> Thank you very much!\"}},{\"id\":\"jJ2kK3lL4m\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Local:</b> You're welcome. Have a good day!\"}}],\"version\":\"2.31.4\"}"
                },
