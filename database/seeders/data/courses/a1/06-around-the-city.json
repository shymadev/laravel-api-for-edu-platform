    {
      "title": "Module 2: Prepositions of Place",
      "subtopics": [],
      "lessons": [
        {
          "title": "In, On, At, Next to, Opposite",
          "weight": 3,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700005003000,\"blocks\":[{\"id\":\"kK7lL8mM9n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Prepositions of place</b> tell us where something is located:\"}},{\"id\":\"nN0oO1pP2q\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>in</b> — inside something: <em>in the building, in the park</em>\",\"<b>on</b> — on a surface: <em>on the street, on the table</em>\",\"<b>at</b> — at a point or place: <em>at the bus stop, at the corner</em>\",\"<b>next to</b> — beside: <em>The café is <b>next to</b> the bank.</em>\",\"<b>opposite</b> — facing: <em>The school is <b>opposite</b> the park.</em>\",\"<b>near / close to</b> — not far: <em>The hospital is <b>near</b> here.</em>\",\"<b>between</b> — in the middle of two things: <em>The library is <b>between</b> the park and the school.</em>\",\"<b>behind</b> — at the back: <em>The car park is <b>behind</b> the cinema.</em>\",\"<b>in front of</b> — facing, before: <em>The bus stop is <b>in front of</b> the hotel.</em>\"]}}],\"version\":\"2.31.4\"}"
            },
            {
              "order": 2,
              "type": "audio",
              "content": {
                "text": "The café is next to the bank. The park is opposite the school.",
                "type": "tts",
                "audio_url": ""
              }
            },
