            {
              "title": "Places and Activities",
              "weight": 2,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700005002000,\"blocks\":[{\"id\":\"vV2wW3xX4y\",\"type\":\"paragraph\",\"data\":{\"text\":\"We can talk about what people do at different places. Use the verb <b>go to</b> + place:\"}},{\"id\":\"yY5zZ6aA7b\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I go to the <b>park</b> to relax.\",\"She goes to the <b>supermarket</b> to buy food.\",\"He goes to the <b>library</b> to read books.\",\"We go to the <b>cinema</b> to watch films.\"]}},{\"id\":\"bB8cC9dD0e\",\"type\":\"paragraph\",\"data\":{\"text\":\"You can also use <b>at</b>:\"}},{\"id\":\"eE1fF2gG3h\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"I am <b>at</b> the bank.\",\"She is <b>at</b> school.\"]}},{\"id\":\"hH4iI5jJ6k\",\"type\":\"paragraph\",\"data\":{\"text\":\"Note: we say <em>go to school/work/hospital</em> (no 'the') when talking about the general activity. But <em>go to the park/cinema/bank</em> (with 'the') for specific places.\"}}],\"version\":\"2.31.4\"}"
                },
