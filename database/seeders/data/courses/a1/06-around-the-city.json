        {
          "title": "3.2 Giving Directions",
          "lessons": [
            {
              "title": "Direction Vocabulary",
              "weight": 6,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700005006000,\"blocks\":[{\"id\":\"vV3wW4xX5y\",\"type\":\"paragraph\",\"data\":{\"text\":\"Here are the key words and phrases for giving directions:\"}},{\"id\":\"yY6zZ7aA8b\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Direction words:</b>\"}},{\"id\":\"bB9cC0dD1e\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>straight ahead / straight on</b> — прямо\",\"<b>turn left</b> — поверните налево\",\"<b>turn right</b> — поверните направо\",\"<b>go past</b> — пройдите мимо\",\"<b>take the first/second left</b> — первый/второй поворот налево\"]}},{\"id\":\"eE2fF3gG4h\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Landmarks:</b>\"}},{\"id\":\"hH5iI6jJ7k\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>at the corner</b> — на углу\",\"<b>at the traffic lights</b> — на светофоре\",\"<b>at the crossroads</b> — на перекрёстке\"]}},{\"id\":\"kK8lL9mM0n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Distance:</b>\"}},{\"id\":\"nN1oO2pP3q\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"It's about <b>5 minutes' walk</b>.\",\"It's not far.\",\"It's on the left / on the right.\"]}}],\"version\":\"2.31.4\"}"
                },
