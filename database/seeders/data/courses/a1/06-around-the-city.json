        {
          "title": "Describing Location",
          "weight": 4,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700005004000,\"blocks\":[{\"id\":\"qQ3rR4sS5t\",\"type\":\"paragraph\",\"data\":{\"text\":\"Let's practice describing where places are in the city using prepositions.\"}},{\"id\":\"tT6uU7vV8w\",\"type\":\"paragraph\",\"data\":{\"text\":\"Example city layout:\"}},{\"id\":\"wW9xX0yY1z\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"The <b>bank</b> is <em>on</em> Main Street.\",\"The <b>supermarket</b> is <em>next to</em> the bank.\",\"The <b>park</b> is <em>opposite</em> the school.\",\"The <b>café</b> is <em>between</em> the bank and the library.\"]}},{\"id\":\"zA2bB3cC4d\",\"type\":\"paragraph\",\"data\":{\"text\":\"Useful question: <b>Where is the ...?</b>\"}},{\"id\":\"dD5eE6fF7g\",\"type\":\"paragraph\",\"data\":{\"text\":\"Useful answer: <em>It is on the left / on the right / straight ahead.</em>\"}}],\"version\":\"2.31.4\"}"
            },
