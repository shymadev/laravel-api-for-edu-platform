                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700005001000,\"blocks\":[{\"id\":\"aA1bB2cC3d\",\"type\":\"paragraph\",\"data\":{\"text\":\"Here are the most important places you will find in a city:\"}},{\"id\":\"dD4eE5fF6g\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Public buildings:</b>\"}},{\"id\":\"gG7hH8iI9j\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>bank</b> — банк\",\"<b>hospital</b> — больница\",\"<b>school</b> — школа\",\"<b>library</b> — библиотека\",\"<b>post office</b> — почта\",\"<b>police station</b> — полицейский участок\"]}},{\"id\":\"jJ0kK1lL2m\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Transport:</b>\"}},{\"id\":\"mM3nN4oO5p\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>bus stop</b> — автобусная остановка\",\"<b>train station</b> — железнодорожная станция\",\"<b>airport</b> — аэропорт\"]}},{\"id\":\"pP6qQ7rR8s\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Leisure and shopping:</b>\"}},{\"id\":\"sS9tT0uU1v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>park</b> — парк\",\"<b>supermarket</b> — супермаркет\",\"<b>cinema</b> — кино\",\"<b>restaurant</b> — ресторан\",\"<b>café</b> — кафе\"]}}],\"version\":\"2.31.4\"}"
