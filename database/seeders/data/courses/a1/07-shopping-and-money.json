          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700006009000,\"blocks\":[{\"id\":\"mM5nN6oO7p\",\"type\":\"paragraph\",\"data\":{\"text\":\"When you pay for something at the shop, you need these phrases:\"}},{\"id\":\"pP8qQ9rR0s\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>At the checkout (у кассы):</b>\"}},{\"id\":\"sS1tT2uU3v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>How would you like to pay?</b> — Как вы хотите оплатить?\",\"<b>Cash or card?</b> — Наличными или картой?\",\"<b>I'll pay by card.</b> — Я заплачу картой.\",\"<b>I'll pay in cash.</b> — Я заплачу наличными.\",\"<b>Here is my card.</b> — Вот моя карта.\",\"<b>Can I have a receipt, please?</b> — Можно мне чек, пожалуйста?\",\"<b>Do you need a bag?</b> — Вам нужен пакет?\",\"<b>Keep the change.</b> — Сдачи не надо.\"]}}],\"version\":\"2.31.4\"}"
            },
