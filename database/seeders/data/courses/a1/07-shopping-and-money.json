            {
              "title": "Reading Prices",
              "weight": 2,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700006002000,\"blocks\":[{\"id\":\"mM3nN4oO5p\",\"type\":\"paragraph\",\"data\":{\"text\":\"In English, we read prices using <b>numbers</b>. Let's practice:\"}},{\"id\":\"pP6qQ7rR8s\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>$1.00</b> — one dollar\",\"<b>$2.50</b> — two dollars fifty\",\"<b>$10.99</b> — ten dollars ninety-nine\",\"<b>£3.75</b> — three pounds seventy-five\",\"<b>€20.00</b> — twenty euros\"]}},{\"id\":\"sS9tT0uU1v\",\"type\":\"paragraph\",\"data\":{\"text\":\"You can also say: <em>It's <b>two fifty</b></em> (informal for $2.50).\"}},{\"id\":\"vV2wW3xX4y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Key numbers to remember:</b>\"}},{\"id\":\"yY5zZ6aA7b\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"10 — ten\",\"20 — twenty\",\"50 — fifty\",\"100 — one hundred\"]}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "How much is this book? It costs three dollars fifty.",
                    "type": "tts",
                    "audio_url": ""
                  }
