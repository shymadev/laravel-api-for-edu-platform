                      "id": "1700006005002",
                      "left": "I'll take it.",
                      "right": "Я возьму это."
                    },
                    {
                      "id": "1700006005003",
                      "left": "Do you have this?",
                      "right": "У вас есть это?"
                    },
                    {
                      "id": "1700006005004",
                      "left": "Here you are.",
                      "right": "Пожалуйста (вот)."
                    },
                    {
                      "id": "1700006005005",
                      "left": "Will that be all?",
                      "right": "Это всё?"
                    }
                  ],
                  "shuffleRight": true
                },
