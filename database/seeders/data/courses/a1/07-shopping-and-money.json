            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700006010000,\"blocks\":[{\"id\":\"vV4wW5xX6y\",\"type\":\"paragraph\",\"data\":{\"text\":\"Let's review the key vocabulary from this course:\"}},{\"id\":\"yY7zZ8aA9b\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Money:</b> coin, banknote, dollar, cent, euro, pound\"}},{\"id\":\"bB0cC1dD2e\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Prices:</b> How much is this? It costs... It's on sale.\"}},{\"id\":\"eE3fF4gG5h\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Shopping phrases:</b> I'm looking for..., Do you have...?, I'll take it., I'll think about it.\"}},{\"id\":\"hH6iI7jJ8k\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Colors:</b> red, blue, green, black, white, grey, pink, purple\"}},{\"id\":\"kK9lL0mM1n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Sizes:</b> small, medium, large, extra large, too tight, too loose, just right\"}},{\"id\":\"nN2oO3pP4q\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Paying:</b> Cash or card?, Can I have a receipt?, Keep the change.\"}},{\"id\":\"qQ5rR6sS7t\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em>You are now ready to go shopping in English!</em>\"}}],\"version\":\"2.31.4\"}"
            },
