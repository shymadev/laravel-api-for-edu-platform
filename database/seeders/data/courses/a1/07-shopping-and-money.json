              "title": "Clothing Sizes",
              "weight": 8,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700006008000,\"blocks\":[{\"id\":\"wW0xX1yY2z\",\"type\":\"paragraph\",\"data\":{\"text\":\"When buying clothes, you need to know <b>sizes</b>:\"}},{\"id\":\"zA3bB4cC5d\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>small (S)</b> — маленький\",\"<b>medium (M)</b> — средний\",\"<b>large (L)</b> — большой\",\"<b>extra large (XL)</b> — очень большой\"]}},{\"id\":\"dD6eE7fF8g\",\"type\":\"paragraph\",\"data\":{\"text\":\"Also useful adjectives:\"}},{\"id\":\"gG9hH0iI1j\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>too big</b> — слишком большой\",\"<b>too small</b> — слишком маленький\",\"<b>too tight</b> — слишком тесный\",\"<b>too loose</b> — слишком свободный\",\"<b>just right</b> — как раз\"]}},{\"id\":\"jJ2kK3lL4m\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Example:</b> <em>Do you have this in a <b>medium</b>? — The large is too big for me.</em>\"}}],\"version\":\"2.31.4\"}"
                },
