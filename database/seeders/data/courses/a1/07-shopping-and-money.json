    {
      "title": "Module 4: Choosing Items — Color and Size",
      "subtopics": [
        {
          "title": "4.1 Colors",
          "lessons": [
            {
              "title": "Colors in Shopping",
              "weight": 7,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700006007000,\"blocks\":[{\"id\":\"nN1oO2pP3q\",\"type\":\"paragraph\",\"data\":{\"text\":\"When shopping for clothes or items, you often need to talk about <b>colors</b>:\"}},{\"id\":\"qQ4rR5sS6t\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>red</b> — красный\",\"<b>blue</b> — синий / голубой\",\"<b>green</b> — зелёный\",\"<b>yellow</b> — жёлтый\",\"<b>black</b> — чёрный\",\"<b>white</b> — белый\",\"<b>grey / gray</b> — серый\",\"<b>brown</b> — коричневый\",\"<b>pink</b> — розовый\",\"<b>orange</b> — оранжевый\",\"<b>purple</b> — фиолетовый\"]}},{\"id\":\"tT7uU8vV9w\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>In a shop:</b> <em>Do you have this in <b>blue</b>?</em>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Do you have this shirt in blue? I'd prefer a black one.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
