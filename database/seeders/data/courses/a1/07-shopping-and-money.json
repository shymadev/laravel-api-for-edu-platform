    {
      "title": "Module 2: Prices and Numbers",
      "subtopics": [
        {
          "title": "2.1 Numbers in Shopping",
          "lessons": [
            {
              "title": "Numbers 1–100",
              "weight": 3,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700006003000,\"blocks\":[{\"id\":\"bB8cC9dD0e\",\"type\":\"paragraph\",\"data\":{\"text\":\"Shopping requires knowing numbers well. Here are the key groups:\"}},{\"id\":\"eE1fF2gG3h\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>1–10:</b> one, two, three, four, five, six, seven, eight, nine, ten\"}},{\"id\":\"hH4iI5jJ6k\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>11–20:</b> eleven, twelve, thirteen, fourteen, fifteen, sixteen, seventeen, eighteen, nineteen, twenty\"}},{\"id\":\"kK7lL8mM9n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Tens:</b> twenty, thirty, forty, fifty, sixty, seventy, eighty, ninety, one hundred\"}},{\"id\":\"nN0oO1pP2q\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Combined:</b>\"}},{\"id\":\"qQ3rR4sS5t\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"25 — twenty-five\",\"43 — forty-three\",\"99 — ninety-nine\"]}},{\"id\":\"tT6uU7vV8w\",\"type\":\"paragraph\",\"data\":{\"text\":\"Practice: <em>The shirt costs <b>thirty-five</b> dollars.</em>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "The shirt costs thirty-five dollars. The shoes cost forty-nine dollars.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
