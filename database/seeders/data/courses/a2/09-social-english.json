            {
              "title": "Complimenting and Thanking",
              "weight": 8,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009108000,\"blocks\":[{\"id\":\"jJ2kK3lL4m\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Compliments</b> and <b>thanks</b> make social interactions more pleasant!\"}},{\"id\":\"mM5nN6oO7p\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Giving compliments:</b>\"}},{\"id\":\"pP8qQ9rR0s\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>You look great!</b> — Ты отлично выглядишь!\",\"<b>That's a lovely dress / shirt!</b> — Какое красивое платье / рубашка!\",\"<b>Your English is really good!</b> — У тебя отличный английский!\",\"<b>What a nice house!</b> — Какой красивый дом!\"]}},{\"id\":\"sS1tT2uU3v\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Responding to compliments:</b>\"}},{\"id\":\"vV4wW5xX6y\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Thank you!</b> / <b>Thanks!</b>\",\"<b>That's very kind of you!</b> — Это очень мило с твоей стороны!\",\"<b>Oh, do you think so?</b> — Ты так думаешь?\"]}},{\"id\":\"yY7zZ8aA9b\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Thanking:</b>\"}},{\"id\":\"bB0cC1dD2e\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Thank you very much.</b> — Большое спасибо.\",\"<b>Thanks a lot!</b> — Огромное спасибо!\",\"<b>That's very helpful.</b> — Это очень полезно.\",\"<b>I really appreciate it.</b> — Я очень ценю это.\"]}}],\"version\":\"2.31.4\"}"
                },
