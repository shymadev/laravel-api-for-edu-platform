            {
              "title": "Responding in Small Talk",
              "weight": 2,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009102000,\"blocks\":[{\"id\":\"pP6qQ7rR8s\",\"type\":\"paragraph\",\"data\":{\"text\":\"Small talk is a two-way conversation. Learn to <b>respond</b> naturally:\"}},{\"id\":\"sS9tT0uU1v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"A: How are you? — B: <b>Fine, thanks. And you?</b>\",\"A: Did you have a good weekend? — B: <b>Yes, it was great! I went to the cinema.</b>\",\"A: Nice weather today! — B: <b>Yes, it's lovely, isn't it!</b>\",\"A: How's work going? — B: <b>Not bad, quite busy actually.</b>\"]}},{\"id\":\"vV2wW3xX4y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Showing interest:</b>\"}},{\"id\":\"yY5zZ6aA7b\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Really?</b> — Правда?\",\"<b>That's great!</b> — Это здорово!\",\"<b>Oh, I see.</b> — Понятно.\",\"<b>Tell me more!</b> — Расскажи подробнее!\",\"<b>How interesting!</b> — Как интересно!\"]}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "A: How are you? B: Fine, thanks. And you? A: Not bad! Did you have a good weekend? B: Yes, it was great!",
                    "type": "tts",
                    "audio_url": ""
                  }
