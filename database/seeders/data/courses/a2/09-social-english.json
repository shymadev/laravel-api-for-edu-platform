          "weight": 9,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700009109000,\"blocks\":[{\"id\":\"eE3fF4gG5h\",\"type\":\"paragraph\",\"data\":{\"text\":\"Let's practise a full <b>social conversation</b>. Read this dialogue:\"}},{\"id\":\"hH6iI7jJ8k\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em><b>Anna:</b> Hi Tom! Long time no see! How are you?</em>\"}},{\"id\":\"kK9lL0mM1n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em><b>Tom:</b> Hi Anna! I'm great, thanks! What have you been up to?</em>\"}},{\"id\":\"nN2oO3pP4q\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em><b>Anna:</b> I've been busy at work. Hey, are you free this Saturday?</em>\"}},{\"id\":\"qQ5rR6sS7t\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em><b>Tom:</b> Yes, I think so! What's happening?</em>\"}},{\"id\":\"tT8uU9vV0w\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em><b>Anna:</b> Would you like to come to a dinner party at my place?</em>\"}},{\"id\":\"wW1xX2yY3z\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em><b>Tom:</b> I'd love to! What time?</em>\"}},{\"id\":\"zA4bB5cC6d\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em><b>Anna:</b> About seven o'clock. Is that OK?</em>\"}},{\"id\":\"dD7eE8fF9g\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em><b>Tom:</b> That works for me! See you Saturday!</em>\"}}],\"version\":\"2.31.4\"}"
            },
