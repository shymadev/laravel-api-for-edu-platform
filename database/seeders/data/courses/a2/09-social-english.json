      "subtopics": [
        {
          "title": "1.1 Starting a Conversation",
          "lessons": [
            {
              "title": "How to Start Small Talk",
              "weight": 1,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009101000,\"blocks\":[{\"id\":\"aA1bB2cC3d\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Small talk</b> is light, friendly conversation — not about serious topics. It helps you connect with people!\"}},{\"id\":\"dD4eE5fF6g\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Common small talk topics:</b>\"}},{\"id\":\"gG7hH8iI9j\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Weather</b> — Nice weather today, isn't it?\",\"<b>Weekend / holidays</b> — Did you have a good weekend?\",\"<b>Work / school</b> — How is work going?\",\"<b>News / sport</b> — Did you see the game last night?\"]}},{\"id\":\"jJ0kK1lL2m\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Useful openers:</b>\"}},{\"id\":\"mM3nN4oO5p\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>How are you?</b> — Как дела?\",\"<b>How's it going?</b> — Как идут дела?\",\"<b>What have you been up to?</b> — Чем занимался?\",\"<b>Long time no see!</b> — Сто лет не виделись!\",\"<b>What a lovely day!</b> — Какой прекрасный день!\"]}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Hi! Long time no see! How's it going? What have you been up to?",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
                  "order": 3,
                  "type": "phrases",
                  "phrases": [
                    {
                      "text": "How are you?",
                      "translation": "Как дела?"
                    },
                    {
                      "text": "How's it going?",
                      "translation": "Как идут дела?"
                    },
                    {
                      "text": "Long time no see!",
                      "translation": "Сто лет не виделись!"
                    },
                    {
                      "text": "What have you been up to?",
                      "translation": "Чем ты занимался?"
                    },
                    {
                      "text": "Nice weather today!",
                      "translation": "Хорошая сегодня погода!"
                    }
                  ]
                },
                {
