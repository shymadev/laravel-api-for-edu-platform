            {
              "title": "Outdoor and Social Hobbies",
              "weight": 2,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000302000,\"blocks\":[{\"id\":\"vW0xY1zA2b\",\"type\":\"paragraph\",\"data\":{\"text\":\"Some people prefer hobbies outside or with other people:\"}},{\"id\":\"cD3eF4gH5i\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>hiking</b> — walking in the countryside or mountains\",\"<b>cycling</b> — riding a bicycle\",\"<b>photography</b> — taking photos\",\"<b>travelling</b> — visiting different places\",\"<b>dancing</b> — moving to music\",\"<b>singing</b> — performing with your voice\",\"<b>playing a musical instrument</b> — guitar, piano, violin, etc.\",\"<b>volunteering</b> — helping others without payment\"]}},{\"id\":\"jK6lM7nO8p\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Talking about how long you have had a hobby:</b><br><em>I have been playing the guitar for two years. / I started hiking last summer.</em>\"}}],\"version\":\"2.31.4\"}"
                },
