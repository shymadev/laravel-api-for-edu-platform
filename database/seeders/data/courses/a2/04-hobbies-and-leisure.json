            {
              "title": "Reading and Collecting",
              "weight": 5,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000305000,\"blocks\":[{\"id\":\"nO0pQ1rS2t\",\"type\":\"paragraph\",\"data\":{\"text\":\"Many people enjoy <b>reading</b> or <b>collecting</b> things as hobbies. Vocabulary:\"}},{\"id\":\"uV3wX4yZ5a\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Types of books:</b>\"}},{\"id\":\"bC6dE7fG8h\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>novel</b> — a long story book\",\"<b>mystery / thriller</b> — an exciting story, often about crime\",\"<b>biography</b> — a book about a real person's life\",\"<b>non-fiction</b> — a book about real facts\"]}},{\"id\":\"iJ9kL0mN1o\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Collecting hobbies:</b>\"}},{\"id\":\"pQ2rS3tU4v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>collect stamps / coins / postcards</b>\",\"<b>collect vintage items</b> — old, classic objects\"]}},{\"id\":\"wX5yZ6aB7c\",\"type\":\"paragraph\",\"data\":{\"text\":\"Describing a hobby: <em>I'm really into mystery novels. / I'm passionate about collecting vintage coins. / I got into photography two years ago.</em>\"}}],\"version\":\"2.31.4\"}"
                },
