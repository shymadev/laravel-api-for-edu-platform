          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700000307000,\"blocks\":[{\"id\":\"yZ7aB8cD9e\",\"type\":\"paragraph\",\"data\":{\"text\":\"Talking about the past is very useful for conversations about leisure. Use the <b>past simple</b> tense to describe what you did:\"}},{\"id\":\"fG0hI1jK2l\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Irregular verbs to know for hobbies:</b>\"}},{\"id\":\"mN3oP4qR5s\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"go → <b>went</b> (I went hiking)\",\"read → <b>read</b> (I read a novel — same spelling, different pronunciation!)\",\"take → <b>took</b> (I took photos)\",\"meet → <b>met</b> (I met my friends)\",\"spend → <b>spent</b> (I spent time at home)\",\"watch → <b>watched</b> (I watched a film)\"]}},{\"id\":\"tU6vW7xY8z\",\"type\":\"paragraph\",\"data\":{\"text\":\"<em>Example: Last weekend I went hiking with my friends. We met at 9 am and spent the whole day in the mountains. In the evening I watched a film and read a few chapters of my book.</em>\"}}],\"version\":\"2.31.4\"}"
            },
            {
