        {
          "title": "3.2 Spending Time with Friends",
          "lessons": [
            {
              "title": "Social Activities",
              "weight": 6,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000306000,\"blocks\":[{\"id\":\"dE8fG9hI0j\",\"type\":\"paragraph\",\"data\":{\"text\":\"Spending time with friends is a great leisure activity. Useful phrases:\"}},{\"id\":\"kL1mN2oP3q\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>hang out (with friends)</b> — spend time together informally\",\"<b>catch up</b> — talk with a friend you haven't seen for a while\",\"<b>have a get-together</b> — have a small informal party\",\"<b>go out for dinner</b> — eat at a restaurant with others\",\"<b>stay in</b> — stay at home instead of going out\"]}},{\"id\":\"rS4tU5vW6x\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Past simple examples:</b><br><em>Last weekend I hung out with my friends. / We had a get-together at my place. / We went out for dinner and caught up.</em>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Last weekend I hung out with my friends. We had a get-together and caught up.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
                  "order": 3,
                  "type": "speech-recognition",
                  "content": {
                    "instructions": "Describe what you did last weekend",
                    "targetPhrase": "Last weekend I hung out with my friends. We went out for dinner and caught up."
                  }
                },
                {
                  "order": 4,
                  "type": "sentence-task",
                  "tasks": [
                    {
                      "sentence": "Last Saturday we ___ out with some friends in the park.",
                      "answers": [
                        "hung",
