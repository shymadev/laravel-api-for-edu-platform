            {
              "title": "Ordering Food and Drinks",
              "weight": 7,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009207000,\"blocks\":[{\"id\":\"qQ4rR5sS6t\",\"type\":\"paragraph\",\"data\":{\"text\":\"When you eat out, you need these <b>restaurant phrases</b>:\"}},{\"id\":\"tT7uU8vV9w\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Arriving and ordering:</b>\"}},{\"id\":\"wW0xX1yY2z\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>A table for two, please.</b> — Столик на двоих, пожалуйста.\",\"<b>Can I see the menu, please?</b> — Можно меню?\",\"<b>Are you ready to order?</b> — Вы готовы сделать заказ? (waiter)\",\"<b>I'd like the chicken, please.</b> — Я бы хотел курицу.\",\"<b>What do you recommend?</b> — Что вы рекомендуете?\"]}},{\"id\":\"zA3bB4cC5d\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>During the meal:</b>\"}},{\"id\":\"dD6eE7fF8g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Excuse me, this is cold.</b> — Извините, это холодное.\",\"<b>Could I have some more water?</b> — Можно ещё воды?\"]}},{\"id\":\"gG9hH0iI1j\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Paying:</b>\"}},{\"id\":\"jJ2kK3lL4m\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Can we have the bill, please?</b> — Счёт, пожалуйста.\",\"<b>Is service included?</b> — Обслуживание включено?\",\"<b>We'd like to pay separately.</b> — Мы хотели бы заплатить по отдельности.\"]}}],\"version\":\"2.31.4\"}"
                },
