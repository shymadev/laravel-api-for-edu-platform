            {
              "title": "On the Bus",
              "weight": 4,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009204000,\"blocks\":[{\"id\":\"qQ3rR4sS5t\",\"type\":\"paragraph\",\"data\":{\"text\":\"Here is what you need to know when <b>travelling by bus</b>:\"}},{\"id\":\"tT6uU7vV8w\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Does this bus go to the city centre?</b> — Этот автобус едет в центр города?\",\"<b>Where do I get off for the museum?</b> — Где мне выходить у музея?\",\"<b>Can I have a single, please?</b> — Один билет, пожалуйста.\",\"<b>Could you tell me when we reach the station?</b> — Скажите, когда мы доедем до станции?\",\"<b>Next stop.</b> — Следующая остановка.\"]}},{\"id\":\"wW9xX0yY1z\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>On the bus — useful words:</b>\"}},{\"id\":\"zA2bB3cC4d\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>bus stop</b> — остановка автобуса\",\"<b>get on</b> — садиться в автобус\",\"<b>get off</b> — выходить из автобуса\",\"<b>route</b> — маршрут\",\"<b>driver</b> — водитель\",\"<b>passenger</b> — пассажир\"]}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Does this bus go to the city centre? Yes it does. Where do I get off for the museum? Get off at the next stop.",
                    "type": "tts",
                    "audio_url": ""
                  }
