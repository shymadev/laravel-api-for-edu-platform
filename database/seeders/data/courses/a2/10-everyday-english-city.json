                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700009202000,\"blocks\":[{\"id\":\"pP6qQ7rR8s\",\"type\":\"paragraph\",\"data\":{\"text\":\"Learn the names of <b>places in a city</b>:\"}},{\"id\":\"sS9tT0uU1v\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>train station / railway station</b> — железнодорожная станция\",\"<b>bus station / bus stop</b> — автовокзал / остановка\",\"<b>airport</b> — аэропорт\",\"<b>post office</b> — почта\",\"<b>bank</b> — банк\",\"<b>hospital</b> — больница\",\"<b>pharmacy / chemist</b> — аптека\",\"<b>supermarket</b> — супермаркет\",\"<b>shopping centre / mall</b> — торговый центр\",\"<b>car park</b> — стоянка\",\"<b>town hall</b> — ратуша / мэрия\",\"<b>museum</b> — музей\",\"<b>park</b> — парк\"]}}],\"version\":\"2.31.4\"}"
                },
