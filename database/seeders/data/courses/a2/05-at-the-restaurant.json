            {
              "title": "Drinks and Dietary Preferences",
              "weight": 2,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000402000,\"blocks\":[{\"id\":\"qR9sT0uV1w\",\"type\":\"paragraph\",\"data\":{\"text\":\"Knowing drinks vocabulary and dietary terms is essential for eating out:\"}},{\"id\":\"xY2zA3bC4d\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Drinks:</b> still water, sparkling water, soft drink (Coke, lemonade), fruit juice, beer, wine (red/white/rosé), tea, coffee, cappuccino, espresso\"}},{\"id\":\"eF5gH6iJ7k\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Dietary terms:</b>\"}},{\"id\":\"lM8nO9pQ0r\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>vegetarian</b> — does not eat meat or fish\",\"<b>vegan</b> — does not eat any animal products\",\"<b>gluten-free</b> — cannot eat wheat/gluten\",\"<b>dairy-free</b> — cannot eat milk products\",\"<b>nut allergy</b> — cannot eat nuts\"]}},{\"id\":\"sT1uV2wX3y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Phrases:</b><br><em>I'm vegetarian. Do you have any vegetarian options? / Is this dish gluten-free?</em>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "matching",
                  "pairs": [
