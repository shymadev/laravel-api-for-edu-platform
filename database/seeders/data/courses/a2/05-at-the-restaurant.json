    {
      "title": "Module 2: Reading the Menu",
      "subtopics": [],
      "lessons": [
        {
          "title": "Understanding a Menu",
          "weight": 3,
          "content": [
            {
              "order": 1,
              "type": "text",
              "content": "{\"time\":1700000403000,\"blocks\":[{\"id\":\"zA4bC5dE6f\",\"type\":\"paragraph\",\"data\":{\"text\":\"A restaurant <b>menu</b> is usually divided into sections. Understanding these will help you order:\"}},{\"id\":\"gH7iJ8kL9m\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>Set menu / table d'hôte</b> — a fixed-price menu with limited choices\",\"<b>À la carte</b> — each dish is priced separately\",\"<b>Daily specials</b> — dishes that change every day\",\"<b>Chef's recommendation</b> — the dish the chef suggests\"]}},{\"id\":\"nO0pQ1rS2t\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Reading dish descriptions — useful adjectives:</b>\"}},{\"id\":\"uV3wX4yZ5a\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>tender</b> — soft and easy to chew (tender chicken)\",\"<b>crispy</b> — hard and slightly crunchy on the outside\",\"<b>creamy</b> — smooth and rich, made with cream\",\"<b>spicy</b> — has a hot, peppery taste\",\"<b>mild</b> — not spicy or strong-tasting\",\"<b>fresh</b> — not frozen, made from new ingredients\"]}}],\"version\":\"2.31.4\"}"
            },
            {
              "order": 2,
              "type": "audio",
              "content": {
                "text": "Today's daily special is creamy pasta. It's mild and very tender.",
                "type": "tts",
                "audio_url": ""
              }
            },
