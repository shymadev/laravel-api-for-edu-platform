        {
          "title": "3.2 Problems and Complaints",
          "lessons": [
            {
              "title": "Handling Problems at the Restaurant",
              "weight": 6,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000406000,\"blocks\":[{\"id\":\"mN3oP4qR5s\",\"type\":\"paragraph\",\"data\":{\"text\":\"Sometimes things go wrong at a restaurant. Here is how to handle it politely:\"}},{\"id\":\"tU6vW7xY8z\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Common problems:</b>\"}},{\"id\":\"aB9cD0eF1g\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"The food is cold / undercooked / overcooked\",\"This is not what I ordered\",\"I've been waiting for a long time\",\"There's a mistake on the bill\"]}},{\"id\":\"hI2jK3lM4n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Phrases to use:</b><br><em>Excuse me, I think there's a problem with my order.</em><br><em>I'm afraid this dish is cold. Could you heat it up, please?</em><br><em>I ordered the pasta, not the pizza.</em><br><em>I've been waiting for 30 minutes. When will my food be ready?</em>\"}},{\"id\":\"oP5qR6sT7u\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>The waiter's response:</b><br><em>I'm terribly sorry about that. / Let me take care of that for you. / I'll bring you a new one immediately.</em>\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "audio",
                  "content": {
                    "text": "Excuse me, I think there's a problem with my order. I'm afraid this dish is cold.",
                    "type": "tts",
                    "audio_url": ""
                  }
                },
                {
                  "order": 3,
                  "type": "sentence-task",
                  "tasks": [
                    {
                      "sentence": "Excuse me, I think there's a ___ with my order.",
                      "answers": [
                        "problem",
                        "mistake",
                        "issue",
                        "trouble"
                      ]
                    },
                    {
                      "sentence": "I'm afraid this soup is ___. Could you heat it up?",
                      "answers": [
                        "cold",
                        "hot",
                        "warm",
                        "spicy"
                      ]
                    }
                  ]
                },
                {
                  "order": 4,
                  "type": "vocabulary-game",
                  "gameType": "find-mistake",
                  "words": [],
                  "oddItems": [],
                  "guessItems": [],
                  "listenItems": [],
                  "mistakeItems": [
                    {
                      "text": "I orderd the pasta, not the pizza.",
                      "correctText": "I ordered the pasta, not the pizza."
                    },
                    {
                      "text": "I've been wait for 30 minutes.",
                      "correctText": "I've been waiting for 30 minutes."
                    }
                  ]
                },
                {
                  "order": 5,
                  "type": "translation",
                  "pairs": [
                    {
                      "id": "1700000406001",
                      "english": "Excuse me, I ordered the pasta, not the pizza.",
                      "russian": "Извините, я заказывал пасту, а не пиццу.",
                      "direction": "eng-ru"
                    },
                    {
                      "id": "1700000406002",
                      "english": "I'm afraid this dish is cold.",
                      "russian": "Боюсь, это блюдо холодное.",
                      "direction": "eng-ru"
