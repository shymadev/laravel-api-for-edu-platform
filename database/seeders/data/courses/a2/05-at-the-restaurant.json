              "content": "{\"time\":1700000408000,\"blocks\":[{\"id\":\"xY0zA1bC2d\",\"type\":\"paragraph\",\"data\":{\"text\":\"Before going to a restaurant, you might need to make a <b>reservation</b>. Here is how to do it on the phone:\"}},{\"id\":\"eF3gH4iJ5k\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Phrases for making a reservation:</b><br><em>I'd like to make a reservation for tonight, please.</em><br><em>I'd like to book a table for four people on Saturday at 7 pm.</em><br><em>Do you have any tables available?</em>\"}},{\"id\":\"lM6nO7pQ8r\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Giving information:</b><br><em>The name is Johnson. / My phone number is...</em><br><em>Do you have a non-smoking section?</em><br><em>Is there a set menu available?</em>\"}},{\"id\":\"sT9uV0wX1y\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Restaurant's reply:</b><br><em>I'm sorry, we're fully booked. / Yes, we have a table available. / We'll see you on Saturday!</em>\"}}],\"version\":\"2.31.4\"}"
