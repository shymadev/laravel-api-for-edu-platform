            {
              "title": "Main Course and Side Dishes",
              "weight": 1,
              "content": [
                {
                  "order": 1,
                  "type": "text",
                  "content": "{\"time\":1700000401000,\"blocks\":[{\"id\":\"aB1cD2eF3g\",\"type\":\"paragraph\",\"data\":{\"text\":\"Let's learn vocabulary for different parts of a meal:\"}},{\"id\":\"hI4jK5lM6n\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Starters (appetisers):</b> soup, salad, garlic bread, bruschetta, chicken wings\"}},{\"id\":\"oP7qR8sT9u\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Main courses:</b>\"}},{\"id\":\"vW0xY1zA2b\",\"type\":\"list\",\"data\":{\"style\":\"unordered\",\"items\":[\"<b>grilled</b> — cooked on a grill (grilled chicken, grilled salmon)\",\"<b>roasted</b> — cooked in an oven (roast beef, roast vegetables)\",\"<b>fried</b> — cooked in hot oil (fried chicken, fried eggs)\",\"<b>baked</b> — cooked in an oven (baked potato, baked salmon)\",\"<b>steamed</b> — cooked with steam (steamed fish, steamed vegetables)\"]}},{\"id\":\"cD3eF4gH5i\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Side dishes:</b> chips (British) / fries (American), mashed potato, rice, couscous, mixed salad\"}},{\"id\":\"jK6lM7nO8p\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Desserts:</b> chocolate cake, ice cream, cheesecake, fruit salad, tiramisu\"}}],\"version\":\"2.31.4\"}"
                },
                {
                  "order": 2,
                  "type": "phrases",
                  "phrases": [
                    {
                      "text": "I'd like the grilled salmon, please.",
                      "translation": "Пожалуйста, жареного лосося."
