includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 5

    parallel:
        maximumNumberOfProcesses: 4

    inferPrivatePropertyTypeFromConstructor: true


    paths:
        - app
        - database
        - routes

    excludePaths:
        analyse:
            - tests/*
            - database/migrations/*
            - config/*

    ignoreErrors:
        -
            message: '#Method App\\Models\\Education\\Paragraphs\\.*::fromArray\(\) should return static.*but returns App\\Models\\Education\\Paragraphs\\.*#'
            path: app/Models/Education/Paragraphs/*
        -
            message: '#Dynamic call to static method Illuminate\\Contracts\\Auth\\Guard::#'
            path: app/Http/*
        -
            message: '#Dynamic call to static method Illuminate\\Database\\Eloquent\\Builder#'
            paths:
                - app/Http/Controllers/*
                - app/Services/*
                - app/Console/Commands/*
                - database/seeders/*
        -
            message: '#PHPDoc tag @return with type .* is incompatible with native type Illuminate\\Database\\Eloquent\\Casts\\Attribute#'
        -
            message: '#Unsafe usage of new static\(\)#'
            path: app/Models/Education/Paragraphs/*
        -
            message: '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::#'
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::#'
        -
            message: '#Call to function in_array\(\) requires parameter \#3 to be set#'
            path: app/Providers/SwaggerUiServiceProvider.php
        -
            message: '#Dynamic call to static method App\\Models\\Additional\\Advertisement::#'
            path: app/Http/Resources/Advertisement/AdvertisementResource.php
        -
            message: '#Dynamic call to static method Illuminate\\Auth\\SessionGuard::logout\(\)#'
            path: app/Http/Controllers/AuthController.php
        -
            message: '#Dynamic call to static method Illuminate\\Http\\Request::validate\(\)#'
        -
            message: '#Access to an undefined property Laravel\\Cashier\\Payment::\$client_secret#'
            path: app/Http/Controllers/SubscriptionController.php
        -
            message: '#Dynamic call to static method Illuminate\\Contracts\\Auth\\Guard::id\(\)#'
            path: app/Logging/DatabaseLogProcessingHandler.php
        -
            message: '#Dynamic call to static method App\\Models\\User\\User::hasLocalPassword\(\)#'
            path: app/Http/Resources/User/UserResource.php
